<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>My bookings | Meghu Travels</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head>
<body><header class="site-header"><a class="brand" href="${pageContext.request.contextPath}/"><span class="brand-mark">M</span> meghu<span>travels</span></a><nav class="main-nav"><a href="${pageContext.request.contextPath}/cars">Book a ride</a><form action="${pageContext.request.contextPath}/logout" method="post"><button class="nav-button">Sign out</button></form></nav></header>
<main class="section dashboard-page"><div class="section-heading"><div><span class="eyebrow">YOUR TRAVEL SPACE</span><h1>My bookings</h1></div><a class="button" href="${pageContext.request.contextPath}/cars">Book another ride <span aria-hidden="true">→</span></a></div>
<c:if test="${not empty notice}"><div class="alert alert-success"><c:out value="${notice}"/></div></c:if><c:if test="${param.created ne null}"><div class="alert alert-success">Your booking request has been sent. Booking #<c:out value="${param.created}"/> is pending confirmation.</div></c:if>
<c:if test="${empty bookings}"><div class="empty-state"><span>↗</span><h2>Your next journey is waiting.</h2><p>You haven’t made a booking yet. Browse the fleet when you’re ready.</p><a class="button" href="${pageContext.request.contextPath}/cars">Explore the fleet <span aria-hidden="true">→</span></a></div></c:if>
<div class="booking-list"><c:forEach var="booking" items="${bookings}"><article class="booking-card"><div class="booking-card-top"><div><span class="eyebrow">BOOKING #<c:out value="${booking.id}"/></span><h2><c:out value="${booking.carName}"/></h2></div><span class="status status-${booking.status}"><c:out value="${booking.status}"/></span></div><div class="booking-info"><div><small>DATES</small><b><c:out value="${booking.startDate}"/> — <c:out value="${booking.endDate}"/></b></div><div><small>JOURNEY</small><b><c:out value="${booking.pickupLocation}"/> → <c:out value="${booking.destination}"/></b></div><div><small>PASSENGERS</small><b><c:out value="${booking.passengers}"/></b></div><div><small>DRIVER</small><b><c:out value="${empty booking.driverName ? 'To be assigned' : booking.driverName}"/></b></div><div><small>ESTIMATED TOTAL</small><b>₹<c:out value="${booking.totalPrice}"/></b></div></div><c:if test="${booking.status eq 'pending'}"><form action="${pageContext.request.contextPath}/my-bookings" method="post" onsubmit="return confirm('Cancel this pending booking?')"><input type="hidden" name="bookingId" value="${booking.id}"><button class="button button-outline button-small" type="submit">Cancel booking</button></form></c:if></article></c:forEach></div>
</main><footer class="site-footer"><a class="brand brand-light" href="${pageContext.request.contextPath}/"><span class="brand-mark">M</span> meghu<span>travels</span></a><span>Go well. Get there.</span><span>© 2026 Meghu Travels</span></footer></body></html>
