<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Manage bookings | Meghu Travels</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head>
<body><header class="site-header"><a class="brand" href="${pageContext.request.contextPath}/"><span class="brand-mark">M</span> meghu<span>travels</span></a><nav class="main-nav"><a href="${pageContext.request.contextPath}/admin/dashboard">Overview</a><a href="${pageContext.request.contextPath}/admin/cars">Cars</a><a href="${pageContext.request.contextPath}/admin/drivers">Drivers</a><form action="${pageContext.request.contextPath}/logout" method="post"><button class="nav-button">Sign out</button></form></nav></header>
<main class="section dashboard-page"><span class="eyebrow">TRIP OPERATIONS</span><div class="section-heading"><div><h1>Bookings</h1><p>Review requests, update trip status, and assign a driver.</p></div></div><c:if test="${not empty error}"><div class="alert alert-error"><c:out value="${error}"/></div></c:if><c:if test="${param.saved eq '1'}"><div class="alert alert-success">Booking changes saved.</div></c:if>
<c:if test="${empty bookings}"><div class="empty-state"><h2>No trips on the board yet.</h2><p>New customer bookings will appear here.</p></div></c:if>
<div class="booking-list"><c:forEach var="booking" items="${bookings}"><article class="booking-card"><div class="booking-card-top"><div><span class="eyebrow">BOOKING #<c:out value="${booking.id}"/> · <c:out value="${booking.customerName}"/></span><h2><c:out value="${booking.carName}"/></h2></div><span class="status status-${booking.status}"><c:out value="${booking.status}"/></span></div><div class="booking-info"><div><small>DATES</small><b><c:out value="${booking.startDate}"/> — <c:out value="${booking.endDate}"/></b></div><div><small>JOURNEY</small><b><c:out value="${booking.pickupLocation}"/> → <c:out value="${booking.destination}"/></b></div><div><small>PASSENGERS</small><b><c:out value="${booking.passengers}"/></b></div><div><small>ESTIMATED TOTAL</small><b>₹<c:out value="${booking.totalPrice}"/></b></div></div><div class="admin-actions"><form action="${pageContext.request.contextPath}/admin/bookings" method="post" class="inline-form"><input type="hidden" name="action" value="status"><input type="hidden" name="bookingId" value="${booking.id}"><label class="sr-only" for="status-${booking.id}">Booking status</label><select id="status-${booking.id}" name="status"><option value="pending" ${booking.status eq 'pending' ? 'selected' : ''}>Pending</option><option value="confirmed" ${booking.status eq 'confirmed' ? 'selected' : ''}>Confirmed</option><option value="completed" ${booking.status eq 'completed' ? 'selected' : ''}>Completed</option><option value="cancelled" ${booking.status eq 'cancelled' ? 'selected' : ''}>Cancelled</option></select><button class="button button-small" type="submit">Update status</button></form><form action="${pageContext.request.contextPath}/admin/bookings" method="post" class="inline-form"><input type="hidden" name="action" value="assign"><input type="hidden" name="bookingId" value="${booking.id}"><label class="sr-only" for="driver-${booking.id}">Assign driver</label><select id="driver-${booking.id}" name="driverId" required><option value="">Assign a driver</option><c:forEach var="driver" items="${drivers}"><option value="${driver.id}" ${booking.driverId eq driver.id ? 'selected' : ''}><c:out value="${driver.fullName}"/></option></c:forEach></select><button class="button button-outline button-small" type="submit">Assign driver</button></form></div></article></c:forEach></div>
</main><footer class="site-footer"><a class="brand brand-light" href="${pageContext.request.contextPath}/"><span class="brand-mark">M</span> meghu<span>travels</span></a><span>Trip operations</span><span>© 2026 Meghu Travels</span></footer></body></html>
