<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Driver dashboard | Meghu Travels</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head>
<body><header class="site-header"><a class="brand" href="${pageContext.request.contextPath}/"><span class="brand-mark">M</span> meghu<span>travels</span></a><nav class="main-nav"><a href="${pageContext.request.contextPath}/driver/dashboard">My trips</a><form action="${pageContext.request.contextPath}/logout" method="post"><button class="nav-button">Sign out</button></form></nav></header>
<main class="section dashboard-page"><span class="eyebrow">DRIVER WORKSPACE</span><div class="section-heading"><div><h1>Your trips, <c:out value="${sessionScope.user.fullName}"/>.</h1><p>Here are the journeys assigned to you.</p></div></div><c:if test="${param.saved eq '1'}"><div class="alert alert-success">Trip status updated.</div></c:if><c:if test="${empty bookings}"><div class="empty-state"><span>↗</span><h2>No assigned trips just yet.</h2><p>Your upcoming journeys will show up here.</p></div></c:if>
<div class="booking-list"><c:forEach var="booking" items="${bookings}"><article class="booking-card"><div class="booking-card-top"><div><span class="eyebrow">BOOKING #<c:out value="${booking.id}"/></span><h2><c:out value="${booking.carName}"/></h2></div><span class="status status-${booking.status}"><c:out value="${booking.status}"/></span></div><div class="booking-info"><div><small>DATES</small><b><c:out value="${booking.startDate}"/> — <c:out value="${booking.endDate}"/></b></div><div><small>CUSTOMER</small><b><c:out value="${booking.customerName}"/></b></div><div><small>PICKUP</small><b><c:out value="${booking.pickupLocation}"/></b></div><div><small>DESTINATION</small><b><c:out value="${booking.destination}"/></b></div><div><small>PASSENGERS</small><b><c:out value="${booking.passengers}"/></b></div></div><c:if test="${booking.status eq 'pending' or booking.status eq 'confirmed'}"><form action="${pageContext.request.contextPath}/driver/dashboard" method="post" class="inline-form"><input type="hidden" name="bookingId" value="${booking.id}"><c:choose><c:when test="${booking.status eq 'pending'}"><input type="hidden" name="status" value="confirmed"><button class="button button-small" type="submit">Accept trip <span aria-hidden="true">→</span></button></c:when><c:otherwise><input type="hidden" name="status" value="completed"><button class="button button-small" type="submit">Mark completed <span aria-hidden="true">✓</span></button></c:otherwise></c:choose></form></c:if></article></c:forEach></div>
</main><footer class="site-footer"><a class="brand brand-light" href="${pageContext.request.contextPath}/"><span class="brand-mark">M</span> meghu<span>travels</span></a><span>Driver workspace</span><span>© 2026 Meghu Travels</span></footer></body></html>
