<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Manage drivers | Meghu Travels</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head>
<body><header class="site-header"><a class="brand" href="${pageContext.request.contextPath}/"><span class="brand-mark">M</span> meghu<span>travels</span></a><nav class="main-nav"><a href="${pageContext.request.contextPath}/admin/dashboard">Overview</a><a href="${pageContext.request.contextPath}/admin/cars">Cars</a><a href="${pageContext.request.contextPath}/admin/bookings">Bookings</a><form action="${pageContext.request.contextPath}/logout" method="post"><button class="nav-button">Sign out</button></form></nav></header>
<main class="section dashboard-page"><span class="eyebrow">TEAM MANAGEMENT</span><div class="section-heading"><div><h1>Your drivers</h1><p>Create driver accounts. Assign them to confirmed trips from bookings.</p></div></div><c:if test="${not empty error}"><div class="alert alert-error"><c:out value="${error}"/></div></c:if><c:if test="${param.saved eq '1'}"><div class="alert alert-success">Driver changes saved.</div></c:if>
<section class="admin-form-panel"><h2>Add a driver</h2><form action="${pageContext.request.contextPath}/admin/drivers" method="post" class="form-stack"><input type="hidden" name="action" value="create"><div class="form-row"><label>Full name<input name="fullName" maxlength="100" required></label><label>Email address<input type="email" name="email" maxlength="190" required></label></div><div class="form-row"><label>Phone number<input type="tel" name="phone" maxlength="30" required></label><label>Temporary password<input type="password" name="password" minlength="8" maxlength="72" required></label></div><button class="button button-small" type="submit">Create driver account <span aria-hidden="true">→</span></button></form></section>
<section class="driver-grid"><c:forEach var="driver" items="${drivers}"><article class="driver-card"><span class="driver-avatar">✦</span><div><h2><c:out value="${driver.fullName}"/></h2><p><c:out value="${driver.email}"/></p><small><c:out value="${driver.phone}"/></small></div></article></c:forEach><c:if test="${empty drivers}"><p class="empty-inline">No driver accounts yet.</p></c:if></section>
</main><footer class="site-footer"><a class="brand brand-light" href="${pageContext.request.contextPath}/"><span class="brand-mark">M</span> meghu<span>travels</span></a><span>Team management</span><span>© 2026 Meghu Travels</span></footer></body></html>
